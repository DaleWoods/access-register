# Postgres connection string
DATABASE_URL="postgresql://register:register@localhost:5432/access_register?schema=public"

# 32+ char secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Where leaver-evidence uploads are written
EVIDENCE_STORAGE_DIR="./storage/evidence"

# --- Email notifications (unset = digest disabled, everything else still works) ---
# RESEND_API_KEY=
# NOTIFICATIONS_FROM_EMAIL="Access Register <register@wosg.example>"
# Shared secret for POST /api/cron/notifications — see README.md → Email notifications
# CRON_SECRET=

# --- Phase 2: Microsoft Entra SSO (unset = local login only) ---
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI="http://localhost:3000/api/auth/callback/entra"
